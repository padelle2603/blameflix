{
  "name": "blameflix-desktop",
  "version": "1.0.0",
  "description": "BlameFlix desktop (Electron wrapper)",
  "main": "main.js",
  "private": true,
  "author": "padelle2603",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never -c.directories.output=../dist/win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.padelle.blameflix",
    "productName": "BlameFlix",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../www", "to": "www" },
      { "from": "../assets/icon.png", "to": "icon.png" }
    ],
    "directories": {
      "output": "../dist/linux"
    },
    "linux": {
      "target": ["AppImage", "dir"],
      "category": "AudioVideo",
      "icon": "../assets/icon.png"
    },
    "win": {
      "target": ["portable"],
      "artifactName": "${productName}-${version}.exe",
      "icon": "../assets/icon.png"
    }
  }
}
