{
  "name": "blameflix",
  "version": "2.4.0",
  "description": "BlameFlix - your screening room",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "sync": "npm run build && cap sync",
    "electron:version": "cd electron && npm run set-version",
    "electron:build": "npm run electron:version && cd electron && npm run dist",
    "electron:build:win": "npm run electron:version && cd electron && npm run dist:win"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
